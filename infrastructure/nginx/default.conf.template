# ClinicDesk AI edge: TLS termination, dashboard static files, /api reverse proxy, WebSocket upgrade, rate limits.
# Rendered by the nginx image's envsubst; only ${SERVER_NAME} is substituted.

limit_req_zone $binary_remote_addr zone=otp:10m rate=5r/m;     # OTP abuse / SMS-pumping (NFR-5)
limit_req_zone $binary_remote_addr zone=hooks:10m rate=30r/s;  # Meta + Exotel callbacks
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream clinicdesk_api {
    server api:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};
    server_tokens off;

    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    include /etc/nginx/snippets/security-headers.conf;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 30s;

    location = /api/v1/auth/otp/request {
        limit_req zone=otp burst=5 nodelay;
        proxy_pass http://clinicdesk_api;
    }
    location = /api/v1/auth/otp/verify {
        limit_req zone=otp burst=10 nodelay;
        proxy_pass http://clinicdesk_api;
    }
    location /api/v1/webhooks/ {
        limit_req zone=hooks burst=60 nodelay;
        access_log off;   # Exotel's secret is in the path; keep it out of logs
        proxy_pass http://clinicdesk_api;
    }
    location = /api/v1/ws {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass http://clinicdesk_api;
    }
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://clinicdesk_api;
    }

    root /usr/share/nginx/html;

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
