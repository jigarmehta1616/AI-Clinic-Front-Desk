# Copy to .env and replace every value. Never commit .env.
ENV=development                      # development | test | staging | production

# --- local docker services (docker-compose.yml) ---
POSTGRES_SUPERUSER_PASSWORD=replace-me
DB_OWNER_PASSWORD=replace-me
DB_APP_PASSWORD=replace-me

# Runtime connection: RLS-subject role (never the owner)
DATABASE_URL=postgresql+asyncpg://clinicdesk_app:replace-me@localhost:5433/clinicdesk
# Migrations: schema owner (sync driver)
MIGRATION_DATABASE_URL=postgresql+psycopg://clinicdesk_owner:replace-me@localhost:5433/clinicdesk
# Tests (separate database, same roles)
TEST_DATABASE_URL=postgresql+asyncpg://clinicdesk_app:replace-me@localhost:5433/clinicdesk_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://clinicdesk_owner:replace-me@localhost:5433/clinicdesk_test

REDIS_URL=redis://localhost:6380/0

# --- auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=replace-me-min-32-chars
JWT_KID=k1
OTP_PEPPER=replace-me-min-32-chars
OTP_PROVIDER=console                 # console (dev only) | whatsapp | sms
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173

# --- integrations (Phase 4/7; leave empty until credentials exist) ---
PUBLIC_BASE_URL=http://localhost:5173
PRIVACY_NOTICE_URL=https://example.invalid/privacy   # DP-1: the clinic's real privacy notice (required in production)
WHATSAPP_PROVIDER=log                # log (dev: no sending) | cloud (Meta Graph API)
WHATSAPP_SHARED_PHONE_NUMBER_ID=     # shared pilot number (open question Q1)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
EXOTEL_WEBHOOK_SECRET=
LLM_PROVIDER=none                    # none (button mode) | openai | gemini
LLM_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
